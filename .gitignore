#
# Root .gitignore for a multi-module Spring Boot / Maven project
#

### Java / Maven ###
# Compiled class files
*.class

# Build directory for all modules
target/

# Packaged archives
*.jar
*.war
*.ear
*.zip
*.tar.gz

# Maven-specific
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

### IDE - IntelliJ IDEA ###
# IDE project-level directory
.idea/

# IDE module files
*.iml

# Other IntelliJ files
*.ipr
*.iws
out/
workspace.xml

### Operating System ###
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

### Log Files ###
*.log
logs/

### Runtime Files ###
*.pid
*.pid.lock

### Environment ###
# Local environment variables
.env
.env.*.local

### Local Data & Persistence ###
# Ignore local database data directories from services
*/mysql/
*/data/

*/volume-data/